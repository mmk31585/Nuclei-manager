        },
        "internal_api.targetRequest": {
            "type": "object",
            "properties": {
                "comment": {
                    "description": "Optional comment",
                    "type": "string",
                    "example": "Public staging estate"
                },
                "exclude": {
                    "description": "Hosts, IPs or CIDRs excluded from the scan",
