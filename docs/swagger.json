            "properties": {
                "comment": {
                    "description": "Optional comment",
                    "type": "string",
                    "example": "Corporate domain"
                },
                "kind": {
                    "description": "Entry type: domain, cidr or ip",
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_mmk31585_Nuclei-manager_internal_domain.ScopeKind"
