SM_HTTP_ADDR=127.0.0.1:8080
SM_GIN_MODE=release
SM_DB_DSN=scanner:scanner@tcp(127.0.0.1:3306)/scanner?charset=utf8mb4&parseTime=True&loc=UTC
SM_DATA_DIR=./data
SM_NUCLEI_BIN=nuclei
SM_CUSTOM_TEMPLATES_DIR=./custom-templates
SM_MAX_CONCURRENT_RUNS=2
SM_WORKER_POLL=2s
# Swagger UI host/basePath used for "Try it out" requests (default localhost[:port]).
SM_SWAGGER_HOST=localhost
SM_SWAGGER_BASE_PATH=/api/v1
